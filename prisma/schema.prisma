// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  // Portal key. Issued by ORBYT when a service engagement starts,
  // never self-served. Null means the account cannot open the portal.
  clientId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submissions        ContactSubmission[]
  onboardingProfile  OnboardingProfile?
  projects           Project[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // Current step of the six stage loop: DISCOVER, DESIGN, BUILD,
  // CONNECT, MEASURE, IMPROVE.
  status    String   @default("DISCOVER")
  startedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates ProjectUpdate[]
  deliverables Deliverable[]
  messages ContactSubmission[]
}

model Deliverable {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  // What it is and what it contains, in one or two honest sentences.
  detail    String   @default("")
  // DELIVERED, IN PREP
  status    String   @default("IN PREP")
  // How the client receives it. EMAIL for now: files travel by email,
  // the portal is the index of what exists, when it landed and where.
  channel   String   @default("EMAIL")
  // Optional. Only set when a real, client-reachable URL exists.
  link      String?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SHIPPED, IN PROGRESS, NOTE
  tag       String   @default("NOTE")
  title     String
  body      String
  // Client sign-off. Set when the client approves a shipped update from
  // the portal; null means it is still awaiting their approval.
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())
}

model OnboardingProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String?
  industry      String?
  stage         String?
  challengesJson String   @default("[]")
  tools         String?
  goal          String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Optional project context when a note is posted from the portal.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}