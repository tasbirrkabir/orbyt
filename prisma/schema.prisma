generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ORBYT CLIENT COMMAND CENTER: domain model
//
// Tenant model: Organization is the client organization (one per
// engagement). Every portal-scoped row carries organizationId so the
// data access layer can scope every query to the authenticated
// client's own organization. No portal query ever runs without it.
//
// Status fields are strings (SQLite has no enums); every one is
// documented with its closed set at the field, and the sets are
// mirrored in src/lib/portal/domain.ts.
// ─────────────────────────────────────────────────────────────

/// The client organization: the tenant boundary for the whole portal.
/// tier drives which portal modules exist for this client:
///   WEBSITE_ONLY        base modules
///   MARKETING_WEBSITE   base + Reports
///   FULL_SERVICE        base + Reports + Systems
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// The portal key ORBYT issues when an engagement starts (ORB-XXXX).
  clientId  String   @unique
  tier      String   @default("WEBSITE_ONLY")
  country   String   @default("BD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  projects      Project[]
  approvals     Approval[]
  requests      Request[]
  files         PortalFile[]
  threads       MessageThread[]
  events        ActivityEvent[]
  systems       SystemEntry[]
  reports       Report[]
  meetings      Meeting[]
  invoices      Invoice[]
  notifications Notification[]
  changeRequests ChangeRequest[]
  decisions     DecisionLogEntry[]

  @@index([clientId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  // Portal key. Issued by ORBYT when a service engagement starts,
  // never self-served. Null means the account cannot open the portal.
  // Kept on the primary contact for login; org members log in with the
  // organization's client ID.
  clientId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Tenant + role. Role closed set: CLIENT_OWNER, CLIENT_MEMBER,
  // CLIENT_VIEWER. Viewers read everything but cannot approve, pay,
  // or post. ORBYT-side staff roles are out of scope for this portal.
  organizationId        String?
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  role                  String        @default("CLIENT_OWNER")
  // Invited members that have not activated yet have no password hash.
  activatedAt           DateTime?
  // Notification preferences: { approvals, requests, reports, billing, systems, meetings }
  notificationPrefsJson String        @default("{}")

  submissions       ContactSubmission[]
  onboardingProfile OnboardingProfile?
  projects          Project[]
  approvalDecisions Approval[]          @relation("ApprovalDecisions")
  requestsFiled     Request[]           @relation("RequestsFiled")

  // Session security. Bumped whenever credentials or MFA change; any
  // JWT carrying an older tokenVersion stops resolving to a portal
  // context, which is how "sign out everywhere" actually works.
  tokenVersion     Int       @default(0)
  lastLoginAt      DateTime?
  // TOTP MFA. mfaPendingSecret holds the secret while setup is being
  // verified; once verified it moves to mfaSecret and mfaEnabledAt is
  // stamped. A user with only a pending secret has MFA off.
  mfaPendingSecret String?
  mfaSecret        String?
  mfaEnabledAt     DateTime?

  resetTokens PasswordResetToken[]
  backupCodes MfaBackupCode[]

  @@index([organizationId])
}

model Project {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  title          String
  /// Human reference code, e.g. PRJ-001.
  code           String?
  // Two orthogonal axes:
  //   stage: the six stage loop: DISCOVER, DESIGN, BUILD, CONNECT,
  //          MEASURE, IMPROVE (the working phase shown on the rail)
  //   status: the health of the engagement: PLANNING, IN_PROGRESS,
  //          IN_REVIEW, BLOCKED, COMPLETED, PAUSED, ARCHIVED
  stage          String        @default("DISCOVER")
  status         String        @default("PLANNING")
  /// What this engagement is: WEBSITE, MARKETING, AUTOMATION, AI, FULL_SERVICE
  type           String        @default("WEBSITE")
  /// One honest sentence about what we are building toward.
  goal           String        @default("")
  /// Who on the ORBYT side owns it day to day (a label, not a user row).
  ownerLabel     String        @default("ORBYT crew")
  // Recorded project health, set by ORBYT with a note. Empty means
  // "not assessed yet" and the UI says exactly that; it is never
  // derived from progress or dates.
  // ON_TRACK, AT_RISK, OFF_TRACK, ON_HOLD
  health         String        @default("")
  /// One honest sentence explaining the health, set together with it.
  healthNote     String        @default("")
  healthUpdatedAt DateTime?
  startedAt      DateTime      @default(now())
  targetLaunchAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  updates      ProjectUpdate[]
  deliverables Deliverable[]
  milestones   Milestone[]
  approvals    Approval[]
  requests     Request[]
  files        PortalFile[]
  threads      MessageThread[]
  meetings     Meeting[]
  messages     ContactSubmission[]
  scopeItems   ScopeItem[]
  changeRequests ChangeRequest[]
  decisions    DecisionLogEntry[]

  @@index([organizationId, status])
  @@index([organizationId])
}

/// Client-visible milestone on the project rail. Progress is computed
/// from DONE count / total, never a hand-typed percentage.
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  // DONE, ACTIVE, UPCOMING
  status      String    @default("UPCOMING")
  position    Int       @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, position])
}

/// A dated note from the crew on the project log. SHIPPED rows carry
/// client sign-off (acknowledgedAt) set when the client approves from
/// the portal; null means still awaiting their approval.
model ProjectUpdate {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SHIPPED, IN PROGRESS, NOTE
  tag            String    @default("NOTE")
  title          String
  body           String
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId, createdAt])
}

model Deliverable {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  // What it is and what it contains, in one or two honest sentences.
  detail        String    @default("")
  // DELIVERED, IN PREP
  status        String    @default("IN PREP")
  // How the client receives it. EMAIL for now: files travel by email,
  // the portal is the index of what exists, when it landed and where.
  channel       String    @default("EMAIL")
  // DRAFT, IN REVIEW, APPROVED, FINAL
  approvalState String    @default("DRAFT")
  version       String    @default("v1")
  // STRATEGY, BRAND, UX, DESIGN, DEVELOPMENT, MARKETING, REPORTS, FINAL, OTHER
  category      String    @default("OTHER")
  // Optional. Only set when a real, client-reachable URL exists.
  link          String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approvals Approval[]

  @@index([projectId])
}

/// A formal sign-off request. Approvals are one-way: once a version is
/// approved it is never silently replaced; a new version means a new
/// approval. History lives in the rows themselves (decidedAt, comment).
model Approval {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deliverableId   String?
  deliverable     Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  title           String
  // What kind of thing is being signed off: DELIVERABLE, COPY, CREATIVE, DOCUMENT
  type            String       @default("DELIVERABLE")
  version         String       @default("v1")
  description     String       @default("")
  // PENDING, APPROVED, CHANGES_REQUESTED
  status          String       @default("PENDING")
  submittedAt     DateTime     @default(now())
  decidedAt       DateTime?
  decidedById     String?
  decidedBy       User?        @relation("ApprovalDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionComment String       @default("")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([deliverableId])
}

/// A structured client request (ticket). The client files it; ORBYT
/// works it and the lifecycle is visible end to end.
model Request {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Human reference code, e.g. REQ-0042.
  code           String
  requesterId    String?
  requester      User?        @relation("RequestsFiled", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterName  String       @default("")
  title          String
  // WEBSITE, DESIGN, MARKETING, TRACKING, AUTOMATION, AI, TECHNICAL, OTHER
  category       String       @default("OTHER")
  // NORMAL, IMPORTANT, URGENT
  priority       String       @default("NORMAL")
  // SUBMITTED, REVIEWING, IN_PROGRESS, WAITING_FOR_CLIENT, COMPLETED, CLOSED
  status         String       @default("SUBMITTED")
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments RequestComment[]

  @@index([organizationId, updatedAt])
  @@index([projectId])
}

model RequestComment {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorName String
  // CLIENT or ORBYT
  authorRole String   @default("CLIENT")
  body       String
  createdAt  DateTime @default(now())

  @@index([requestId, createdAt])
}

/// The secure file index. Files travel by email; this is the tenant-
/// scoped index of what exists, with metadata, so nothing lives in one
/// inbox or one person's memory. A row with a real link offers it;
/// rows without one never render a fake download button.
model PortalFile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name           String
  kind           String       @default("pdf")
  sizeKb         Int          @default(0)
  version        String       @default("v1")
  // STRATEGY, BRAND, UX, DESIGN, DEVELOPMENT, MARKETING, REPORTS, FINAL, OTHER
  category       String       @default("OTHER")
  // DRAFT, SHARED, FINAL, ARCHIVED
  status         String       @default("SHARED")
  uploadedBy     String       @default("ORBYT")
  note           String       @default("")
  // Optional. Only set when a real, client-reachable URL exists.
  link           String?
  uploadedAt     DateTime     @default(now())

  @@index([organizationId, uploadedAt])
  @@index([projectId])
}

/// A project-linked conversation, not a chat clone. Threads attach to
/// a project (or stand alone); each keeps both sides of the exchange.
model MessageThread {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subject        String
  // PROJECT, REQUEST, APPROVAL, DELIVERABLE, MEETING, GENERAL
  context        String       @default("GENERAL")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]

  @@index([organizationId, updatedAt])
}

model Message {
  id           String        @id @default(cuid())
  threadId     String
  thread       MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderName   String
  // CLIENT or ORBYT
  senderRole   String        @default("CLIENT")
  body         String
  readByClient Boolean       @default(true)
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
}

/// The immutable chronological record of what happened, client-visible.
/// Doubles as the audit trail for client-facing actions (approvals,
/// request lifecycle, file events); ORBYT-side internal audit is a
/// server concern and never exposed here.
model ActivityEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // PROJECT, REQUEST, APPROVAL, DELIVERABLE, FILE, REPORT, SYSTEM, BILLING, MEETING, MESSAGE, ACCOUNT
  type           String
  title          String
  actorName      String
  // CLIENT or ORBYT
  actorRole      String       @default("ORBYT")
  targetType     String       @default("")
  targetLabel    String       @default("")
  /// Deep link into the portal, when one exists.
  link           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
}

/// A system ORBYT builds, runs or monitors for the client. Full-service
/// tenants only. Health states are recorded facts, never decoration:
///   HEALTHY, WARNING, ISSUE, OFFLINE, NOT_CONNECTED, MONITORING,
///   ACTIVE, PAUSED
model SystemEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // WEBSITE, TRACKING, ANALYTICS, MARKETING, AUTOMATION, AI, FORMS, INTEGRATIONS, CRM, NOTIFICATIONS
  category       String
  status         String       @default("MONITORING")
  description    String       @default("")
  /// For automations: what starts it and what it does.
  trigger        String       @default("")
  actions        String       @default("")
  /// JSON array of connected service names.
  connectedJson  String       @default("[]")
  ownerLabel     String       @default("ORBYT")
  lastCheckedAt  DateTime?
  lastUpdatedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  checks SystemCheck[]
  runs   AutomationRun[]

  @@index([organizationId])
}

/// One recorded health check for a system. Status closed set mirrors
/// SystemEntry. Empty checks mean "not checked yet", never "healthy".
model SystemCheck {
  id        String      @id @default(cuid())
  systemId  String
  system    SystemEntry @relation(fields: [systemId], references: [id], onDelete: Cascade)
  name      String
  status    String      @default("HEALTHY")
  note      String      @default("")
  checkedAt DateTime    @default(now())

  @@index([systemId, checkedAt])
}

/// One execution of an automation, for the run history.
model AutomationRun {
  id       String      @id @default(cuid())
  systemId String
  system   SystemEntry @relation(fields: [systemId], references: [id], onDelete: Cascade)
  summary  String
  // OK, FAILED
  status   String      @default("OK")
  ranAt    DateTime    @default(now())

  @@index([systemId, ranAt])
}

/// A published performance report. Metrics and series are stored as
/// JSON snapshots. Status NOT_CONNECTED means exactly that: no data
/// source is wired up yet, and the UI says so instead of inventing
/// numbers. Demo rows are labeled as sample data at render time.
model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  // 7D, 30D, 90D
  period         String       @default("30D")
  // READY, NOT_CONNECTED
  status         String       @default("NOT_CONNECTED")
  dataSource     String       @default("")
  /// JSON: [{ key, label, value, prev, unit, question }]
  metricsJson    String       @default("[]")
  /// JSON: [{ key, label, unit, points: [{ label, value }] }]
  seriesJson     String       @default("[]")
  note           String       @default("")
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model Meeting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title          String
  startsAt       DateTime
  durationMins   Int          @default(30)
  agenda         String       @default("")
  // UPCOMING, COMPLETED
  status         String       @default("UPCOMING")
  notes          String       @default("")
  decisions      String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organizationId, startsAt])
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Human reference like INV-0002. Unique within an organization; the
  /// seeder and the API guard that, not a global index.
  number         String
  issueDate      DateTime
  dueDate        DateTime
  description    String
  subtotalCents  Int
  taxCents       Int          @default(0)
  totalCents     Int
  currency       String       @default("BDT")
  // DRAFT, PENDING, PAID, OVERDUE, CANCELLED
  status         String       @default("PENDING")
  paidAt         DateTime?
  method         String       @default("")
  createdAt      DateTime     @default(now())

  payments Payment[]

  @@index([organizationId, issueDate])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  // BANK_TRANSFER, BKASH, NAGAD, CARD
  method      String   @default("BANK_TRANSFER")
  reference   String   @default("")
  paidAt      DateTime @default(now())

  @@index([invoiceId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // APPROVAL, REQUEST, REPORT, SYSTEM, BILLING, MEETING, PROJECT, ACCOUNT
  type           String
  title          String
  body           String       @default("")
  link           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, readAt])
}

/// Server-side audit log for security-relevant client actions.
/// Immutable from the client interface: no API writes to it except
/// append, and nothing in the portal renders it.
model AuditLog {
  id           String   @id @default(cuid())
  actorEmail   String
  actorRole    String   @default("CLIENT")
  action       String
  targetType   String   @default("")
  targetLabel  String   @default("")
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([actorEmail, createdAt])
  @@index([createdAt])
}

/// One outbound email: the durable record of everything ORBYT sends.
/// Rows are written before the provider dispatch and move QUEUED ->
/// SENT | FAILED after it, so delivery state is always a stored fact.
/// The EmailService (src/lib/email) owns this lifecycle.
model EmailMessage {
  id        String    @id @default(cuid())
  toEmail   String
  subject   String
  textBody  String
  htmlBody  String?
  /// Template identifier, e.g. auth.password_reset.
  template  String    @default("")
  // QUEUED, SENT, FAILED
  status    String    @default("QUEUED")
  /// Which provider handled it: console (dev) or a real one (resend).
  provider  String    @default("console")
  error     String    @default("")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([toEmail])
}

/// Single-use, hashed one-time token. The raw token only ever exists
/// inside the email link; the database stores a SHA-256 digest.
/// Expired or used tokens are dead on arrival.
/// kind closes the two uses of the same machinery:
///   RESET  self-service password reset (30 minutes)
///   INVITE first activation for a provisioned owner (7 days)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  // RESET, INVITE
  kind      String    @default("RESET")
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One MFA recovery code, SHA-256 hashed like every other secret.
/// A code is consumed by a successful use and never regenerated in
/// place; a new batch invalidates the old one.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OnboardingProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String?
  industry       String?
  stage          String?
  challengesJson String    @default("[]")
  tools          String?
  goal           String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Optional project context when a note is posted from the portal.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Lead lifecycle. Every inbound contact is a lead; the closed set:
  //   NEW, CONTACTED, QUALIFIED, CONVERTED, ARCHIVED
  // CONVERTED is terminal and always carries convertedOrganizationId.
  status String @default("NEW")
  /// Set when lifecycle.convert turns this lead into a tenant.
  convertedOrganizationId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([status, createdAt])
}

/// One line of project scope: what the engagement includes, and just
/// as important, what it explicitly excludes. Managed by the ORBYT
/// crew; visible to the client. Scope changes go through change
/// requests, not silent edits.
model ScopeItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  detail    String   @default("")
  // INCLUSION, EXCLUSION
  kind      String   @default("INCLUSION")
  // PLANNED, IN_PROGRESS, DONE, DROPPED
  status    String   @default("PLANNED")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, position])
}

/// A formal change to scope. Either side can raise it: the client asks
/// for something new, ORBYT proposes a change with its impact spelled
/// out. The other side decides. Decisions are one-way records and land
/// in the project decision log automatically. Closed set:
///   PROPOSED, ACCEPTED, DECLINED, WITHDRAWN
model ChangeRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Human reference, CR-0001, unique within the organization.
  code           String
  title          String
  description    String
  // CLIENT, ORBYT
  raisedBy       String       @default("CLIENT")
  raisedByName   String       @default("")
  /// The honest cost of the change, in words: effort, dates, price.
  impactNote     String       @default("")
  // PROPOSED, ACCEPTED, DECLINED, WITHDRAWN
  status         String       @default("PROPOSED")
  decidedAt      DateTime?
  decidedByName  String       @default("")
  // CLIENT, ORBYT
  decidedByRole  String       @default("")
  decisionNote   String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([projectId, createdAt])
}

/// The project decision log: what was decided, why, by whom, when.
/// Immutable from the portal interface: entries are created (also
/// automatically, from change-request decisions) and never edited or
/// deleted. This is the "why does it work this way" record.
model DecisionLogEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The decision, in one line, past tense.
  title          String
  /// Why it was decided; the context a reader needs later.
  context        String       @default("")
  // CLIENT, ORBYT
  decidedByRole  String       @default("ORBYT")
  decidedByName  String
  // CHANGE_REQUEST, REQUEST, MEETING, APPROVAL, OTHER
  sourceType     String       @default("OTHER")
  /// Human reference of the source, e.g. CR-0002.
  sourceLabel    String       @default("")
  decidedAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([projectId, decidedAt])
  @@index([organizationId, decidedAt])
}
