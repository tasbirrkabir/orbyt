# SQLite Database URL (relative to prisma/schema.prisma)
DATABASE_URL="file:../db/custom.db"

# Storage Configuration
# Set STORAGE_PROVIDER to "s3" or "local"
STORAGE_PROVIDER="s3"

# Cloudflare R2 / AWS S3 Credentials
R2_ACCOUNT_ID="1e6a089a9a27e1a0ccf9ff2e832df27d"
R2_ACCESS_KEY_ID="your_access_key_id"
R2_SECRET_ACCESS_KEY="your_secret_access_key"
R2_BUCKET="orbyt-storage"
R2_ENDPOINT="https://1e6a089a9a27e1a0ccf9ff2e832df27d.r2.cloudflarestorage.com"
